@model CinemaWebsite.Models.CinemaHall

@{
    ViewData["Title"] = "Create Hall";
}

<div class="page-header">
    <h2>Create Hall</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Back</a>
</div>

<div class="form-page-card">
    <div class="card">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control"/>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Number" class="form-label"></label>
                        <input asp-for="Number" class="form-control"/>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Capacity" class="form-label"></label>
                        <input asp-for="Capacity" class="form-control"/>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="HallType" class="form-label"></label>
                        <select asp-for="HallType" asp-items="Html.GetEnumSelectList<CinemaWebsite.Models.HallType>()" class="form-select"></select>
                    </div>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsAvailable" class="form-check-input"/>
                    <label asp-for="IsAvailable" class="form-check-label">Available</label>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" type="submit">Save</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
