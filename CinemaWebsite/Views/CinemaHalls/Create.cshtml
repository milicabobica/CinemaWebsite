@model CinemaWebsite.Models.CinemaHall
<h3>Create Hall</h3>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control mb-2" />

    <label asp-for="Number" class="form-label"></label>
    <input asp-for="Number" class="form-control mb-2" />

    <label asp-for="Capacity" class="form-label"></label>
    <input asp-for="Capacity" class="form-control mb-2" />

    <label asp-for="HallType" class="form-label"></label>
    <select asp-for="HallType" asp-items="Html.GetEnumSelectList<CinemaWebsite.Models.HallType>()" class="form-select mb-2"></select>

    <div class="form-check mb-2">
        <input asp-for="IsAvailable" class="form-check-input" />
        <label asp-for="IsAvailable" class="form-check-label"></label>
    </div>

    <button class="btn btn-primary" type="submit">Save</button>
</form>
