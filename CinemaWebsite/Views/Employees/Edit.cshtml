@model CinemaWebsite.Models.Employee

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="page-header">
    <h2>Edit Employee</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Back</a>
</div>

<div class="form-page-card">
    <div class="card">
        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                <input type="hidden" asp-for="Id"/>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control"/>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control"/>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Position" class="form-label"></label>
                    <input asp-for="Position" class="form-control"/>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control"/>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control"/>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="PhotoUrl" class="form-label"></label>
                    <input asp-for="PhotoUrl" class="form-control" placeholder="https://…"/>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" type="submit">Save</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
