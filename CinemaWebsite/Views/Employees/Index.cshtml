@model IEnumerable<CinemaWebsite.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="page-header">
    <h2>Employees</h2>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success">+ Add employee</a>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">👥</div>
        <p class="text-muted">No employees found.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var e in Model)
        {
            <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                <div class="card h-100">
                    @if (!string.IsNullOrWhiteSpace(e.PhotoUrl))
                    {
                        <img src="@e.PhotoUrl" class="card-img-top" alt="Photo of @e.FirstName @e.LastName" style="height: 200px; object-fit: cover;" loading="lazy">
                    }
                    else
                    {
                        <div class="card-img-top d-flex align-items-center justify-content-center bg-dark" style="height: 200px;">
                            <span class="fs-1 text-muted">@e.FirstName.FirstOrDefault()@e.LastName.FirstOrDefault()</span>
                        </div>
                    }
                    
                    <div class="card-body d-flex flex-column gap-2 text-center">
                        <h5 class="card-title mb-0">
                            <a asp-action="Details" asp-route-id="@e.Id" class="text-decoration-none" style="color:var(--text)">
                                @e.FirstName @e.LastName
                            </a>
                        </h5>
                        <p class="text-muted mb-2">@e.Position</p>
                        
                        <div class="mt-auto d-flex justify-content-center gap-2 flex-wrap">
                            <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@e.Id" class="btn btn-sm btn-danger">Delete</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
