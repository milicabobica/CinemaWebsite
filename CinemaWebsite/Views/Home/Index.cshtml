@model CinemaWebsite.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home";
    ViewData["BodyClass"] = "home-page";
}

@if (Model.NowShowingMovies.Any())
{
    <section class="home-hero-marquee text-center">
        <h1 class="display-4 fw-bold mb-2 text-white">Welcome to CinemaWebsite</h1>
        <p class="lead text-white-50 mb-4">Your premium destination for the latest blockbusters and timeless classics.</p>

        <div class="marquee-container">
            <div class="marquee-track">
                <!-- Group 1 -->
                <div class="marquee-group">
                    @for (int i = 0; i < 2; i++)
                    {
                        foreach (var m in Model.NowShowingMovies)
                        {
                            <div class="marquee-item">
                                <a asp-controller="Movies" asp-action="Details" asp-route-id="@m.Id">
                                    <img src="@(string.IsNullOrWhiteSpace(m.PosterUrl) ? "https://placehold.co/400x600/12172A/5B7B9A?text=No+Poster" : m.PosterUrl)" alt="@m.Title">
                                </a>
                            </div>
                        }
                    }
                </div>
                <!-- Duplicate group for seamless looping -->
                <div class="marquee-group" aria-hidden="true">
                    @for (int i = 0; i < 2; i++)
                    {
                        foreach (var m in Model.NowShowingMovies)
                        {
                            <div class="marquee-item">
                                <a asp-controller="Movies" asp-action="Details" asp-route-id="@m.Id">
                                    <img src="@(string.IsNullOrWhiteSpace(m.PosterUrl) ? "https://placehold.co/400x600/12172A/5B7B9A?text=No+Poster" : m.PosterUrl)" alt="@m.Title">
                                </a>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </section>
}
else
{
    <section class="home-hero-marquee d-flex align-items-center justify-content-center bg-dark" style="min-height: 400px; border: 1px solid var(--border); border-radius: 16px; margin: 2rem 0;">
        <div class="text-center p-4">
            <h1 class="text-white mb-4">Welcome to CinemaWebsite</h1>
            <a class="home-hero-btn" asp-controller="Movies" asp-action="Index">
                Browse movies <span aria-hidden="true">→</span>
            </a>
        </div>
    </section>
}

@if (Model.NowShowingMovies.Any())
{
    <section class="home-section">
        <div class="section-heading-row">
            <h3>Now Showing</h3>
            <a asp-controller="Movies" asp-action="Index" asp-route-status="NowShowing">Browse all →</a>
        </div>
        <div class="home-card-grid">
            @foreach (var m in Model.NowShowingMovies)
            {
                <article class="home-movie-card">
                    <a class="movie-poster-wrap" asp-controller="Movies" asp-action="Details" asp-route-id="@m.Id">
                        <img src="@(string.IsNullOrWhiteSpace(m.PosterUrl) ? "https://placehold.co/400x600/12172A/5B7B9A?text=No+Poster" : m.PosterUrl)"
                             alt="@m.Title poster" loading="lazy"/>
                    </a>
                    <div class="movie-card-content">
                        <h4><a asp-controller="Movies" asp-action="Details" asp-route-id="@m.Id">@m.Title</a></h4>
                        <p>@m.ReleaseDate.ToString("dd MMM yyyy")</p>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (Model.ComingSoonMovies.Any())
{
    <section class="home-section">
        <div class="section-heading-row">
            <h3>Coming Soon</h3>
            <a asp-controller="Movies" asp-action="Index" asp-route-status="ComingSoon">See schedule →</a>
        </div>
        <div class="home-card-grid">
            @foreach (var m in Model.ComingSoonMovies)
            {
                <article class="home-movie-card">
                    <a class="movie-poster-wrap" asp-controller="Movies" asp-action="Details" asp-route-id="@m.Id">
                        <img src="@(string.IsNullOrWhiteSpace(m.PosterUrl) ? "https://placehold.co/400x600/12172A/5B7B9A?text=No+Poster" : m.PosterUrl)"
                             alt="@m.Title poster" loading="lazy"/>
                    </a>
                    <div class="movie-card-content">
                        <h4><a asp-controller="Movies" asp-action="Details" asp-route-id="@m.Id">@m.Title</a></h4>
                        <p>@m.ReleaseDate.ToString("dd MMM yyyy")</p>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (Model.LatestNews.Any())
{
    <section class="home-section">
        <div class="section-heading-row">
            <h3>Latest News</h3>
            <a asp-controller="News" asp-action="Index">All news →</a>
        </div>
        <div class="news-card-list">
            @foreach (var n in Model.LatestNews)
            {
                <div class="news-card-item">
                    <span class="news-dot" aria-hidden="true"></span>
                    <a asp-controller="News" asp-action="Details" asp-route-id="@n.Id">@n.Title</a>
                </div>
            }
        </div>
    </section>
}

@if (Model.Services.Any())
{
    <section class="home-section">
        <div class="section-heading-row">
            <h3>Our Services</h3>
            <a asp-controller="Services" asp-action="Index">View all →</a>
        </div>
        <div class="services-grid">
            @foreach (var s in Model.Services)
            {
                <div class="service-card">
                    <h5>@s.Name</h5>
                    @if (!string.IsNullOrWhiteSpace(s.Description))
                    {
                        <p>@(s.Description.Length > 90 ? s.Description[..90] + "…" : s.Description)</p>
                    }
                </div>
            }
        </div>
    </section>
}