@model CinemaWebsite.Models.Movie

@{
    ViewData["Title"] = "Create Movie";
}

<div class="page-header">
    <h2>Create Movie</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Back</a>
</div>

<div class="form-page-card">
    <div class="card">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control"/>
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Director" class="form-label"></label>
                        <input asp-for="Director" class="form-control"/>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Cast" class="form-label"></label>
                        <input asp-for="Cast" class="form-control"/>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Duration" class="form-label"></label>
                        <input asp-for="Duration" class="form-control" placeholder="minutes"/>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="ReleaseDate" class="form-label"></label>
                        <input asp-for="ReleaseDate" type="datetime-local" class="form-control"/>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Genres</label>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var genre in ViewBag.Genres)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="selectedGenreIds" value="@genre.Id"/>
                                <label class="form-check-label">@genre.Name</label>
                            </div>
                        }
                    </div>
                    <span class="text-danger small">@Html.ValidationMessage("selectedGenreIds")</span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Language" class="form-label"></label>
                        <input asp-for="Language" class="form-control"/>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="SubtitleLanguage" class="form-label"></label>
                        <input asp-for="SubtitleLanguage" class="form-control"/>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="AgeRating" class="form-label"></label>
                        <input asp-for="AgeRating" class="form-control"/>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Rating" class="form-label"></label>
                        <input asp-for="Rating" class="form-control" step="0.1"/>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="PosterUrl" class="form-label"></label>
                    <input asp-for="PosterUrl" class="form-control" placeholder="https://…"/>
                </div>

                <div class="mb-4">
                    <label asp-for="TrailerUrl" class="form-label"></label>
                    <input asp-for="TrailerUrl" class="form-control" placeholder="YouTube URL"/>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" type="submit">Save</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
