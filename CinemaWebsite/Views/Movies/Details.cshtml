@model CinemaWebsite.Models.Movie

<img src="@Model.PosterUrl" width="80"/>
<h3>@Model.Title</h3>
<p>@Model.Description</p>
@{ string? trailer = Model.TrailerUrl; string? embedUrl = null; if (!string.IsNullOrWhiteSpace(trailer)) { if (trailer.Contains("youtube.com/embed/")) { embedUrl = trailer; } else if (trailer.Contains("watch?v=")) { embedUrl = trailer.Replace("watch?v=", "embed/"); } else if (trailer.Contains("youtu.be/")) { var id = trailer.Split('/').Last(); embedUrl = $"https://www.youtube.com/embed/{id}"; } }
}
@if (!string.IsNullOrWhiteSpace(embedUrl))
{
    <p><strong>Trailer:</strong>
        <iframe src="@embedUrl" width="1053" height="592" title="@Model.Title Trailer" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
    </p>
}
else if (!string.IsNullOrWhiteSpace(trailer))
{
    <p><strong>Trailer:</strong> <a href="@trailer" target="_blank" rel="noopener">Watch trailer</a></p>
}
else
{
    <p><strong>Trailer:</strong> Not available</p>
}
<p><strong>Director:</strong> @Model.Director</p>
<p><strong>Cast:</strong> @Model.Cast</p>
@if (Model.MovieGenres.Any())
{
    <div class="mb-3">
        <strong>Genres:</strong>

        @foreach (var movieGenre in Model.MovieGenres)
        {
            <span class="badge bg-secondary">
                @movieGenre.Genre.Name
            </span>
        }
    </div>
}
<p><strong>Language:</strong> @Model.Language</p>
<p><strong>Subtitle language:</strong> @Model.SubtitleLanguage</p>
<p><strong>Age rating:</strong> @Model.AgeRating</p>
<p><strong>Rating:</strong> @Model.Rating</p>

<h4 class="mt-4">Upcoming Screenings</h4>

@if (Model.Screenings.Any(s => s.StartTime >= DateTime.UtcNow))
{
    <div class="list-group">
        @foreach (var screening in Model.Screenings
                      .Where(s => s.StartTime >= DateTime.UtcNow)
                      .OrderBy(s => s.StartTime))
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>
                        @screening.StartTime.ToString("dd/MM/yyyy HH:mm")
                    </strong>
                    <br />
                    <span>
                        @screening.CinemaHall.Name
                    </span>
                    <br />
                    <span>
                        Price: @screening.Price
                    </span>
                </div>

                <a asp-controller="Reservations"
                   asp-action="Create"
                   asp-route-screeningId="@screening.Id"
                   class="btn btn-primary">
                    Book
                </a>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted">No upcoming screenings available.</p>
}

<a asp-action="Index">Back</a>
