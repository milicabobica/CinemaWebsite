@model CinemaWebsite.Models.Movie

<img src="@Model.PosterUrl" width="80"/>
<h3>@Model.Title</h3>
<p>@Model.Description</p>
<p><strong>Trailer:</strong><iframe src="https://www.youtube.com/embed/pBk4NYhWNMM" width="1053" height="592" title="Barbie | Main Trailer" frameborder="0"></iframe></p>
@* <iframe width="1053" height="592" src="https://www.youtube.com/embed/pBk4NYhWNMM" title="Barbie | Main Trailer" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe> *@
<p><strong>Director:</strong> @Model.Director</p>
<p><strong>Cast:</strong> @Model.Cast</p>
<p><strong>Language:</strong> @Model.Language</p>
<p><strong>Age rating:</strong> @Model.AgeRating</p>
<p><strong>Rating:</strong> @Model.Rating</p>

<h4>Screenings</h4>
<ul>
@foreach (var screening in Model.Screenings.OrderBy(s => s.StartTime))
{
    <li>
        @screening.StartTime.ToString("D HH:mm") - @screening.CinemaHall.Name - @screening.Price
        @* @if (User.Identity?.IsAuthenticated == true) *@
        @* { *@
        @*     <a asp-controller="Reservations" asp-action="Create" asp-route-screeningId="@screening.Id">Reserve</a> *@
        @* } *@
        <a asp-controller="Reservations" asp-action="Create" asp-route-screeningId="@screening.Id">Reserve</a>
    </li>
}
</ul>

<a asp-action="Index">Back</a>
