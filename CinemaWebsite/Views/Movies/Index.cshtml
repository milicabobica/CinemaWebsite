    <!-- Filter -->
    <div class="col-md-1">
        <button class="btn btn-primary w-100" type="submit">
            Filter
        </button>
    </div>

</form>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-success">
            Create movie
        </a>
    </p>
}

<table class="table table-striped">

    <thead>
    <tr>
        <th>Title</th>
        <th>Language</th>
        <th>Release</th>
        <th>Day</th>
        <th></th>
    </tr>
    </thead>

    <tbody>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.Title</td>

            <td>@item.Language</td>

            <td>
                @item.ReleaseDate.ToString("yyyy-MM-dd")
            </td>

            <td>
                @item.ReleaseDate.ToString("dddd")
            </td>

            <td>

                <a asp-action="Details"
                   asp-route-id="@item.Id">
                    Details
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <span> | </span>

                    <a asp-action="Edit"
                       asp-route-id="@item.Id">
                        Edit
                    </a>

                    <span> | </span>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id">
                        Delete
                    </a>
                }

            </td>

        </tr>
    }

    </tbody>

</table>


