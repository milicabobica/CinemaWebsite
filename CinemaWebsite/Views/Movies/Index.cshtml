@model IEnumerable<CinemaWebsite.Models.Movie>

@{
    ViewData["Title"] = "Movies";
}

<h3>Movies</h3>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><input class="form-control" name="search" value="@Context.Request.Query["search"]" placeholder="Search" /></div>
    <div class="col-md-2"><input class="form-control" name="language" value="@Context.Request.Query["language"]" placeholder="Language" /></div>
    <div class="col-md-2">
        <select class="form-select" name="status">
            <option value="">Any status</option>
            <option value="NowShowing">Now showing</option>
            <option value="ComingSoon">Coming soon</option>
        </select>
    </div>
    <div class="col-md-2"><button class="btn btn-primary" type="submit">Filter</button></div>
</form>

@if (User.IsInRole("Admin"))
{
    <p><a asp-action="Create" class="btn btn-success">Create movie</a></p>
}

<table class="table table-striped">
    <thead><tr><th>Title</th><th>Language</th><th>Release</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Language</td>
            <td>@item.ReleaseDate.ToString("yyyy-MM-dd")</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                @if (User.IsInRole("Admin"))
                {
                    <span> | </span><a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <span> | </span><a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
