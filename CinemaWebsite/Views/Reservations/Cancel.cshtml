@model CinemaWebsite.Models.Reservation
<h3>Cancel Reservation</h3>
<p>Cancel reservation for <strong>@Model.Screening.Movie.Title</strong>?</p>
<form asp-action="Cancel" method="post">
    <input type="hidden" asp-for="Id" />
    @if (ViewBag.GuestToken is string guestToken)
    {
        <input type="hidden" name="token" value="@guestToken" />
    }
    <button class="btn btn-danger" type="submit">Cancel reservation</button>
</form>
