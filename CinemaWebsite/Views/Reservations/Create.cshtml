@model CinemaWebsite.Models.Reservation
@{ var screening = ViewBag.Screening as CinemaWebsite.Models.Screening; }
<h3>Reserve Tickets</h3>
@if (screening is null)
{
    <div class="alert alert-danger">Screening information is unavailable. Please return and try again.</div>
}
else
{
    <p>@screening.Movie.Title - @screening.StartTime.ToString("dd/MM/yyyy HH:mm") </p>
}
<form asp-action="Create" method="post">
    <input type="hidden" asp-for="ScreeningId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <label asp-for="NumberOfTickets" class="form-label"></label>
    <input asp-for="NumberOfTickets" class="form-control mb-2" />
    <span asp-validation-for="NumberOfTickets" class="text-danger"></span>

    <button class="btn btn-primary" type="submit">Reserve</button>
</form>
