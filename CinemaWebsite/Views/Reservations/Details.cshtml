@model CinemaWebsite.ViewModels.ReservationDisplayViewModel
@{
    ViewData["Title"] = "Reservation Details";
}

<section class="confirmation-page">
    <div class="confirmation-card">
        <div class="confirmation-success">
            <span class="confirmation-icon" aria-hidden="true">✓</span>
            <div>
                <h1>Reservation #@Model.Id</h1>
                <p>Your booking details are ready.</p>
            </div>
        </div>

        @if (TempData["PaymentSuccessMessage"] is string paymentSuccessMessage)
        {
            <div class="confirmation-alert">@paymentSuccessMessage</div>
        }

        <div class="confirmation-details">
            <div class="confirmation-row">
                <span>Movie</span>
                <strong>@Model.MovieTitle</strong>
            </div>
            <div class="confirmation-row">
                <span>Hall</span>
                <strong>@Model.HallName</strong>
            </div>
            <div class="confirmation-row">
                <span>Screening</span>
                <strong>@Model.ScreeningStartTime.ToString("dd/MM/yyyy HH:mm")</strong>
            </div>
            <div class="confirmation-row">
                <span>Seats</span>
                <strong>@(Model.Seats.Any() ? string.Join(", ", Model.Seats.Select(s => $"Row {s.Row}, Seat {s.Number}")) : "No seats assigned")</strong>
            </div>
            <div class="confirmation-row">
                <span>Tickets</span>
                <strong>@Model.NumberOfTickets</strong>
            </div>
            <div class="confirmation-row">
                <span>Status</span>
                <strong>@(Model.Status == CinemaWebsite.Models.ReservationStatus.Confirmed ? "Paid" : Model.Status.ToString())</strong>
            </div>

            <hr />

            <div class="confirmation-total">
                <span>Total</span>
                <strong>@Model.TotalPrice</strong>
            </div>
        </div>

        <div class="confirmation-actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back</a>
        </div>
    </div>
</section>
