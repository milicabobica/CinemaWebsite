@model CinemaWebsite.ViewModels.ReservationDisplayViewModel
<h3>Reservation #@Model.Id</h3>
@if (TempData["PaymentSuccessMessage"] is string paymentSuccessMessage)
{
    <div class="alert alert-success">@paymentSuccessMessage</div>
}
<p><strong>Movie:</strong> @Model.MovieTitle</p>
<p><strong>Hall:</strong> @Model.HallName</p>
<p><strong>Screening:</strong> @Model.ScreeningStartTime.ToString("dd/MM/yyyy HH:mm")</p>
<p><strong>Seats:</strong> @(Model.Seats.Any() ? string.Join(", ", Model.Seats.Select(s => $"Row {s.Row}, Seat {s.Number}")) : "No seats assigned")</p>
<p><strong>Tickets:</strong> @Model.NumberOfTickets</p>
<p><strong>Total:</strong> @Model.TotalPrice</p>
<p><strong>Status:</strong> @(Model.Status == CinemaWebsite.Models.ReservationStatus.Confirmed ? "Paid" : Model.Status.ToString())</p>
<a asp-controller="Home" asp-action="Index" >Back</a>
