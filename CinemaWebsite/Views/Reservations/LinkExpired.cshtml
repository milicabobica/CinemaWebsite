@section Head {
    <link rel="stylesheet" href="~/css/payment.css" asp-append-version="true"/>
}

@{
    ViewData["Title"] = "Reservation link expired";
}

<section class="confirmation-page">
    <div class="confirmation-card form-page-card">
        <div class="confirmation-status">
            <div>
                <h1>This link has expired</h1>
                <p>For your privacy, guest booking links are available until 24 hours after the screening starts.</p>
            </div>
        </div>
        <p>If you still need help with your booking, please contact us.</p>
        <div class="confirmation-actions d-flex flex-wrap gap-2">
            <a class="btn btn-primary" asp-controller="ContactMessages" asp-action="Create">Contact us</a>
            <a class="btn btn-outline-secondary" asp-controller="Movies" asp-action="Index">Browse movies</a>
        </div>
    </div>
</section>
