@model IEnumerable<CinemaWebsite.Models.Reservation>
<h3>My Reservations</h3>
<table class="table"><tr><th>Movie</th><th>Tickets</th><th>Total</th><th>Status</th><th></th></tr>@foreach (var r in Model){<tr><td>@r.Screening.Movie.Title</td><td>@r.NumberOfTickets</td><td>@r.TotalPrice</td><td>@r.Status</td><td><a asp-action="Details" asp-route-id="@r.Id">Details</a></td></tr>}</table>
