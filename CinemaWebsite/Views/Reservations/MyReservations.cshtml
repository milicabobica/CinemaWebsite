@using CinemaWebsite.Models
@model IEnumerable<CinemaWebsite.ViewModels.ReservationDisplayViewModel>
@{
    ViewData["Title"] = "My Reservations";
}

<div class="page-header">
    <h2>My Reservations</h2>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">🎟️</div>
        <p class="text-muted">You haven't made any reservations yet.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Browse movies</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
            <tr>
                <th>Movie</th>
                <th>Screening</th>
                <th>Seats</th>
                <th>Tickets</th>
                <th>Total</th>
                <th>Status</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var r in Model)
            {
                var canCancel = r.Status != ReservationStatus.Cancelled && r.ScreeningStartTime > DateTime.UtcNow;
                var (badgeClass, statusLabel) = r.Status switch
                {
                    ReservationStatus.Confirmed => ("bg-success", "Paid"),
                    ReservationStatus.Cancelled when r.ExpiresAtUtc.HasValue => ("bg-secondary", "Expired"),
                    ReservationStatus.Cancelled => ("bg-danger", "Cancelled"),
                    _ => ("bg-warning text-dark", "Awaiting payment")
                };

                <tr>
                    <td class="fw-semibold">@r.MovieTitle</td>
                    <td>@r.ScreeningStartTime.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (r.Seats.Any())
                        {
                            <span class="small text-muted">@string.Join(", ", r.Seats.Select(s => $"{s.Row}{s.Number}"))</span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>@r.NumberOfTickets</td>
                    <td>@r.TotalPrice.ToString("C", new System.Globalization.CultureInfo("de-DE"))</td>
                    <td><span class="badge @badgeClass">@statusLabel</span></td>
                    <td>
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            @if (canCancel)
                            {
                                <form asp-action="Cancel" asp-route-id="@r.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">Cancel</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
