@model IEnumerable<CinemaWebsite.ViewModels.ReservationDisplayViewModel>
<h3>My Reservations</h3>
<table class="table"><tr><th>Movie</th><th>Screening</th><th>Seats</th><th>Tickets</th><th>Total</th><th>Status</th><th></th></tr>@foreach (var r in Model){<tr><td>@r.MovieTitle</td><td>@r.ScreeningStartTime.ToString("dd/MM/yyyy HH:mm")</td><td>@(r.Seats.Any() ? string.Join(", ", r.Seats.Select(s => $"{s.Row}{s.Number}")) : "-")</td><td>@r.NumberOfTickets</td><td>@r.TotalPrice</td><td>@r.Status</td><td><a asp-action="Details" asp-route-id="@r.Id">Details</a></td></tr>}</table>
