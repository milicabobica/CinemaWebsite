@model CinemaWebsite.ViewModels.PaymentViewModel
@{
    ViewData["Title"] = "Payment";
}

<h1>Payment</h1>

<div class="pill-breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a><span>&gt;</span><a asp-controller="Reservations" asp-action="MyReservations">Reservations</a><span>&gt;</span><span>Payment</span></div>

<div class="row g-4 booking-shell booking-reference-shell">
    <div class="col-lg-7">
        <div class="app-card p-4 p-lg-5 booking-payment-card">
            <h1 class="h2 fw-bold mb-2">Confirm and pay</h1>
            <p class="text-muted mb-4">Complete payment to finalize your reservation.</p>

            <form asp-action="Payment" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="ReservationId" type="hidden" />
                <input asp-for="AccessToken" type="hidden" />
                <input asp-for="IsEmailRequired" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" readonly="@(!Model.IsEmailRequired)" />
                    @if (!Model.IsEmailRequired)
                    {
                        <div class="form-text">Using your account email.</div>
                    }
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

            <div class="mb-3">
                <label asp-for="CardholderName" class="form-label"></label>
                <input asp-for="CardholderName" class="form-control" />
                <span asp-validation-for="CardholderName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CardNumber" class="form-label"></label>
                <input asp-for="CardNumber" class="form-control" maxlength="16" />
                <span asp-validation-for="CardNumber" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ExpirationDate" class="form-label"></label>
                    <input asp-for="ExpirationDate" class="form-control" placeholder="MM/YY" />
                    <span asp-validation-for="ExpirationDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Cvv" class="form-label"></label>
                    <input asp-for="Cvv" class="form-control" maxlength="4" />
                    <span asp-validation-for="Cvv" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="BillingAddress" class="form-label"></label>
                <textarea asp-for="BillingAddress" class="form-control" rows="2"></textarea>
                <span asp-validation-for="BillingAddress" class="text-danger"></span>
            </div>

                <button type="submit" class="btn btn-primary">Confirm and pay</button>
                @* <a asp-controller="Reservations" asp-action="Create" asp-route-screeningId="@Model.ReservationId" class="btn btn-outline-secondary">Back</a> *@
            </form>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="app-card payment-summary-card p-4" style="position: sticky; top: 100px;">
            <h5 class="fw-bold mb-3">Price details</h5>
            <p class="mb-2 text-muted">Reservation ID: #@Model.ReservationId</p>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span>Total Price</span>
                <span class="fw-bold fs-4">@Model.TotalPrice.ToString("C")</span>
            </div>
            <span class="status-badge status-pending">Status: Pending Payment</span>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}