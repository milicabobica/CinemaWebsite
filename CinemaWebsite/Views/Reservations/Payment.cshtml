@model CinemaWebsite.ViewModels.PaymentViewModel
@{
    ViewData["Title"] = "Payment";
}

<section class="payment-page">
    @* <div class="payment-breadcrumb"> *@
    @*     <a asp-controller="Home" asp-action="Index">Home</a> *@
    @*     <span>&gt;</span> *@
    @*     <a asp-controller="Reservations" asp-action="MyReservations">Reservations</a> *@
    @*     <span>&gt;</span> *@
    @*     <span>Payment</span> *@
    @* </div> *@

    <div class="row g-4 payment-shell">
        <div class="col-lg-7">
            <div class="payment-card">
                <h1 class="payment-title">Confirm and pay</h1>
                <p class="payment-subtitle">Complete payment to finalize your reservation.</p>

                @if (Model.ExpiresAtUtc.HasValue)
                {
                    <div id="holdCountdown" class="payment-countdown" data-expires-at="@(Model.ExpiresAtUtc.Value.ToString("yyyy-MM-ddTHH:mm:ss.fff") + "Z")">
                        <span aria-hidden="true">⏱</span>
                        <span>Your seats are held for <strong id="holdCountdownValue">10:00</strong></span>
                    </div>
                }

                <form asp-action="Payment" method="post" class="payment-form">
                    @Html.AntiForgeryToken()
                    <input asp-for="ReservationId" type="hidden" />
                    <input asp-for="ScreeningId" type="hidden" />
                    <input asp-for="AccessToken" type="hidden" />
                    <input asp-for="IsEmailRequired" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="payment-field">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" readonly="@(!Model.IsEmailRequired)" />
                        @if (!Model.IsEmailRequired)
                        {
                            <div class="form-text">Using your account email.</div>
                        }
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="payment-field">
                        <label asp-for="CardholderName" class="form-label"></label>
                        <input asp-for="CardholderName" class="form-control" />
                        <span asp-validation-for="CardholderName" class="text-danger"></span>
                    </div>

                    <div class="payment-field">
                        <label asp-for="CardNumber" class="form-label"></label>
                        <input asp-for="CardNumber" class="form-control" maxlength="16" />
                        <span asp-validation-for="CardNumber" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 payment-field">
                            <label asp-for="ExpirationDate" class="form-label"></label>
                            <input asp-for="ExpirationDate" class="form-control" placeholder="MM/YY" />
                            <span asp-validation-for="ExpirationDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 payment-field">
                            <label asp-for="Cvv" class="form-label"></label>
                            <input asp-for="Cvv" class="form-control" maxlength="4" />
                            <span asp-validation-for="Cvv" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="payment-field">
                        <label asp-for="BillingAddress" class="form-label"></label>
                        <textarea asp-for="BillingAddress" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="BillingAddress" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary payment-cta">Confirm and pay</button>
                </form>
            </div>
        </div>
        <div class="col-lg-5">
            <aside class="payment-summary">
                <h2 class="payment-summary-title">Reservation summary</h2>

                @* <div class="payment-summary-row"> *@
                @*     <span>Reservation</span> *@
                @*     <strong>#@Model.ReservationId</strong> *@
                @* </div> *@
                <div class="payment-summary-row">
                    <span>Movie</span>
                    <strong>@Model.MovieTitle</strong>
                </div>
                <div class="payment-summary-row">
                    <span>Hall</span>
                    <strong>@Model.HallName</strong>
                </div>
                <div class="payment-summary-row">
                    <span>Screening</span>
                    <strong>@Model.ScreeningStartTime.ToString("dd/MM/yyyy HH:mm")</strong>
                </div>
                <div class="payment-summary-row">
                    <span>Seats</span>
                    <strong>@(Model.Seats.Any() ? string.Join(", ", Model.Seats.Select(s => $"Row {s.Row}, Seat {s.Number}")) : "-")</strong>
                </div>
                <div class="payment-summary-row">
                    <span>Status</span>
                    <strong>Pending payment</strong>
                </div>

                <hr />

                <div class="payment-total">
                    <span>Total</span>
                    <strong>@Model.TotalPrice.ToMoney()</strong>
                </div>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    @if (Model.ExpiresAtUtc.HasValue)
    {
        <script>
            (function () {
                var countdownEl = document.getElementById('holdCountdown');
                var valueEl = document.getElementById('holdCountdownValue');
                if (!countdownEl || !valueEl) return;

                var expiresAtMs = new Date(countdownEl.dataset.expiresAt).getTime();
                var redirectUrl = '@Url.Action("Create", "Reservations", new { screeningId = Model.ScreeningId, expired = 1 })';
                var redirected = false;

                function tick() {
                    var remainingMs = expiresAtMs - Date.now();
                    if (remainingMs <= 0) {
                        valueEl.textContent = '0:00';
                        countdownEl.classList.add('is-urgent');
                        if (!redirected) {
                            redirected = true;
                            window.location.href = redirectUrl;
                        }
                        return;
                    }

                    var totalSeconds = Math.floor(remainingMs / 1000);
                    var minutes = Math.floor(totalSeconds / 60);
                    var seconds = totalSeconds % 60;
                    valueEl.textContent = minutes + ':' + String(seconds).padStart(2, '0');
                    countdownEl.classList.toggle('is-urgent', totalSeconds <= 60);
                }

                tick();
                setInterval(tick, 1000);
            })();
        </script>
    }
}