@{ var seatMap = ViewBag.SeatMap as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>(); var screening = ViewBag.Screening as CinemaWebsite.Models.Screening; }

@{
    var grouped = seatMap.GroupBy(s => (string)s.Row).OrderBy(g => g.Key);
}

<div id="seat-map" class="seat-map" data-price="@(screening?.Price.ToString("F2") ?? "0.00")" role="application" aria-label="Seat map">
    <div class="screen">SCREEN</div>

    @foreach (var rowGroup in grouped)
    {
        <div class="seat-row" data-row="@rowGroup.Key">
            <div class="row-label">@rowGroup.Key</div>
            <div class="row-seats">
                @foreach (var seat in rowGroup.OrderBy(s => (int)s.Number))
                {
                    var seatId = (int)seat.SeatId;
                    var isReserved = (bool)seat.IsReserved;
                    var isCouple = seat.SeatType == CinemaWebsite.Models.SeatType.Couple;
                    var pairSeatId = seat.PairSeatId as int?;
                    var couplePosClass = isCouple ? ((int)seat.Number % 2 == 1 ? " couple-left" : " couple-right") : "";
                    var css = (isReserved ? "seat reserved" : "seat available") + couplePosClass;
                    var seatLabel = $"{rowGroup.Key}{seat.Number}";
                    <button type="button" class="@css" data-seat-id="@seatId" data-pair-id="@(pairSeatId?.ToString() ?? "")" title="Seat @seatLabel" aria-label="Seat @seatLabel" @(isReserved ? "disabled" : "")>
                        <span class="seat-number">@seat.Number</span>
                    </button>
                }
            </div>
        </div>
    }

    <div class="seat-summary mt-2">
        <span>Selected: <strong id="selectedCount">0</strong></span>
        <span class="ms-3">Price per seat: <strong id="seatPrice">@((screening?.Price.ToString("F2")) ?? "0.00")</strong></span>
        <span class="ms-3">Total: <strong id="totalPrice">0.00</strong></span>
    </div>

    <div class="seat-legend mt-2">
        <span class="legend-item"><span class="legend-box available"></span> Available</span>
        <span class="legend-item ms-3"><span class="legend-box selected"></span> Selected</span>
        <span class="legend-item ms-3"><span class="legend-box reserved"></span> Reserved</span>
        <span class="legend-item ms-3"><span class="legend-box couple"></span> Couple</span>
    </div>
</div>

<input type="hidden" id="selectedSeatIds" name="selectedSeatIds" />

<link href="/css/seatmap.css" rel="stylesheet" />
<script src="/js/seatmap.js"></script>