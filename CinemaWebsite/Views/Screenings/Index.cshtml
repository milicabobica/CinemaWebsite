@model IEnumerable<CinemaWebsite.Models.Screening>
<h3>Screenings</h3>
@if (User.IsInRole("Admin")){<p><a asp-action="Create" class="btn btn-success">Create</a></p>}
<table class="table"><tr>
    <th>Movie</th><th>Hall</th><th>Start</th><th>Price</th><th></th>
</tr>@foreach (var s in Model)
     {
         <tr><td>@s.Movie.Title</td>
             <td>@s.CinemaHall.Name</td>
             <td>@s.StartTime</td>
             <td>@s.Price</td>
             <td><a asp-action="Details" asp-route-id="@s.Id">Details</a> |
                 <a asp-action="Edit" asp-route-id="@s.Id">Edit</a> |
                 <a asp-action="Delete" asp-route-id="@s.Id">Delete</a> 
                 </td> 
             </tr>
     }</table>
